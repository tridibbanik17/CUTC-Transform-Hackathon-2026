{
  "name": "coursechat",
  "version": "0.1.11",
  "description": "Chrome extension that turns your LMS course page into an AI tutor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.config.sw.ts && vite build --config vite.config.cs.ts",
    "build:panel": "vite build",
    "build:sw": "vite build --config vite.config.sw.ts",
    "build:cs": "vite build --config vite.config.cs.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "pdfjs-dist": "^4.9.155",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "fast-check": "^4.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
