{
  "manifest_version": 3,
  "name": "CourseChat - AI Study Tutor for Your Course Materials",
  "version": "0.1.0",
  "description": "Upload your course materials, ask questions, get cited answers. AI study tutor powered by your free Gemini API key.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "side-panel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content-script.js"]
    }
  ],
  "action": {
    "default_title": "CourseChat"
  },
  "commands": {
    "_execute_side_panel": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open CourseChat"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pdf-parser/index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "sandbox": {
    "pages": ["pdf-parser/index.html"]
  }
}
