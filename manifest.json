{
  "manifest_version": 3,
  "name": "CourseChat",
  "version": "0.1.0",
  "description": "Turn your LMS course page into an AI-powered study tutor with cited sources.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "side-panel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content-script.js"]
    }
  ],
  "action": {
    "default_title": "CourseChat"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pdf-parser/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
